# ─────────────────────────────────────────────────────────────
# AI File Converter — Environment Variables
# Copy this file to .env and adjust as needed
# ─────────────────────────────────────────────────────────────

# Backend
DATABASE_URL=postgresql+asyncpg://aifc:aifc@localhost:5432/aifc
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=./storage
STORAGE_TTL_DAYS=7
MODELS_PATH=./models
# SEGMENTER_MODEL_PATH=./models/semantic_segmenter.onnx
# SEGMENTER_MODEL_URL=https://example.com/semantic_segmenter.onnx
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=true

# DWG conversion uses an external converter because DWG is proprietary.
# Install libredwg's `dwgwrite`, ODA FileConverter, or provide a Docker-sidecar command.
# Placeholders available: {input}, {output}, {input_dir}, {output_dir}, {stem}
# DWG_CONVERTER_COMMAND='dwgwrite {input} {output}'

# Job recovery — seconds a job may stay in "processing" before being marked
# as failed by the stale-job sweeper (default: 300 = 5 minutes).
JOB_STALE_TIMEOUT_SECONDS=300

# Docker worker memory limits (used by docker-compose.yml).
# Increase these if the ONNX segmentation model + image pipeline triggers OOM.
# WORKER_MEM_LIMIT=4g
# WORKER_MEMSWAP_LIMIT=6g

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Docker Compose (overrides for container networking)
# When running via docker-compose, the services use internal networking:
# DATABASE_URL=postgresql+asyncpg://aifc:aifc@postgres:5432/aifc
# REDIS_URL=redis://redis:6379/0
# NEXT_PUBLIC_API_URL=http://localhost:8000