# ─────────────────────────────────────────────────────────────
# AI File Converter — Root .gitignore
# Covers: Node.js, Python, IDE, OS, Docker, and project-specific
# ─────────────────────────────────────────────────────────────

# ─── Node.js / Frontend ───────────────────────────────────────
# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
.next/
out/
build/
dist/
.turbo/

# Next.js specific
next-env.d.ts
*.tsbuildinfo

# Testing
coverage/
*.lcov
.nyc_output/

# Frontend env files
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ─── Python / Backend ─────────────────────────────────────────
# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/

# Testing / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Type checkers
pyrightconfig.json

# Backend env files
backend/.env
backend/.env.local
backend/.env.*.local

# ─── IDE & Editors ────────────────────────────────────────────
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains (IntelliJ, PyCharm, WebStorm)
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
\#*\#
.\#*

# ─── OS Files ─────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ─── Docker ────────────────────────────────────────────────────
# Docker volumes (local dev data)
.docker/
docker-data/

# ─── Project-Specific ─────────────────────────────────────────
# Uploaded files & conversion output (runtime artifacts)
storage/
uploads/
output/
models/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc
.cache/
.temp/
tmp/
*.pid
*.seed
*.pid.lock